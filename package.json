{
  "name": "dspec",
  "version": "0.1.0",
  "description": "Stop paying your coding agent to re-read your product every session. dspec writes it down once in .ds/ \u2014 a form Claude Code, Codex and Cursor read fast.",
  "keywords": [
    "dspec",
    "code-map",
    "codebase-map",
    "context",
    "claude-code",
    "codex",
    "cursor",
    "agents",
    "ai",
    "local",
    "cli"
  ],
  "homepage": "https://github.com/tuna781/dspec#readme",
  "bugs": {
    "url": "https://github.com/tuna781/dspec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuna781/dspec.git"
  },
  "author": "tuna <tuandv.job@gmail.com>",
  "license": "MIT",
  "bin": {
    "dspec": "bin/ds.js",
    "ds": "bin/ds.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "tsc && node --test test/*.test.js",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm run build"
  }
}
