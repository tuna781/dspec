{
  "name": "dspec",
  "version": "0.8.0",
  "description": "Your coding agent knows your codebase like someone who has worked on it for years. dspec keeps a map in .ds/ — what each feature is, every way people refer to it, where it lives, what it does, and what a change must not break — read by Claude Code, Codex and Cursor.",
  "keywords": [
    "dspec",
    "code-map",
    "codebase-map",
    "context",
    "monorepo",
    "onboarding",
    "claude-code",
    "codex",
    "cursor",
    "agents",
    "ai",
    "local",
    "cli"
  ],
  "homepage": "https://github.com/tuna781/dspec#readme",
  "bugs": {
    "url": "https://github.com/tuna781/dspec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuna781/dspec.git"
  },
  "author": "tuna <tuandv.job@gmail.com>",
  "license": "MIT",
  "bin": {
    "dspec": "bin/ds.js",
    "ds": "bin/ds.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "tsc && node --test test/*.test.js",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm run build"
  }
}
